  "_comment": "Single source of truth for SnowSafe city configuration. Each entry drives etl/run_all.py and the in-app city picker.",
  "_schema": {
    "key": "machine name, used as filename prefix and URL hash",
    "display_name_en": "English label shown in UI",
    "display_name_cn": "Chinese label for bilingual toggle",
    "lat": "city center latitude (default map center)",
    "lng": "city center longitude",
    "default_zoom": "Leaflet zoom level",
    "data_source": "yrp = York Regional Police ArcGIS, toronto_ckan = Toronto open data CSV",
    "yrp_municipality": "filter value for YRP API (only yrp cities)",
    "neighbourhood_oids": "York Region EDI boundary OBJECTIDs (only yrp cities)",
    "snow_source_city": "city whose snow CSV to reuse (all reuse toronto since GTA climate zone)",
    "collision_min_year": "filter collision records to >= this year"
